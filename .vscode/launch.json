{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Launch Persimmon Web App",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "restart": true
        },
        {
            "name": "Launch Chrome (http://127.0.0.1:5000)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5000",
            "webRoot": "${workspaceFolder}"
        }
    ]
}